  <experiments>
    <experiment name="DW-DS-Het" repetitions="2500" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>number-of-males</metric>
        <metric>300 - number-of-males</metric>
        <metric><![CDATA[count turtles with [ color = turquoise and short-term-count > 0 ]]]></metric>
        <metric><![CDATA[count turtles with [ color = orange and short-term-count > 0 ]]]></metric>
        <metric>sum [ short-term-count ] of turtles with [ color = turquoise ]</metric>
        <metric>sum [ short-term-count ] of turtles with [ color = orange ]</metric>
        <metric>sum [ number-of-short-partners ] of turtles with [ color = turquoise ]</metric>
        <metric>sum [ number-of-short-partners ] of turtles with [ color = orange ]</metric>
        <metric>avg-unique-partners-of-in-pool-males</metric>
        <metric>avg-unique-partners-of-in-pool-females</metric>
        <metric>avg-encounters-of-in-pool-males</metric>
        <metric>avg-encounters-of-in-pool-females</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-of-males">
          <value value="150"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="movement-range">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="long-term-likelihood">
          <value value="10"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="male-willingness">
          <value value="40"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="female-willingness">
          <value value="25"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="male-desirability-standard">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="female-desirability-standard">
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="all-homosexual?">
          <value value="false"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
