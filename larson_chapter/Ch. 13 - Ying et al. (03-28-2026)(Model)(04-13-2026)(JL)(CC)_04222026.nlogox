<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[globals [
  starting-seed
  avg-unique-partners-of-in-pool-males
  avg-unique-partners-of-in-pool-females
  avg-encounters-of-in-pool-males
  avg-encounters-of-in-pool-females
]

turtles-own [
  desirability               ;; the turtle's own desirability as a short-term mate
  desirability-standard      ;; the turtle's desirability standard for others as a short-term mates (applied when judging other turtles' desirability)
  coupled?                   ;; boolean variable for the relationship status
  partner                    ;; the turtles long-term partner
  willingness                ;; the likelihood of an agent engaging in short-term mating
  short-term-mate?           ;; whether the turtles decide to engage in short-term mating
  had-short-term-mate?       ;; whether the turtles has had a short-term mate on this iteration
  short-term-count           ;; count of short-term mating encounters
  short-term-history         ;; a list of turtles' unique short-term mating partners
  number-of-short-partners   ;; number of turtles' unique short-term mating partners
  initiator?                 ;; (only in the same-sex model) whether a turtle initiates coupling
  original-x                 ;; x coordinate when spawned
  original-y                 ;; y coordinate when spawned
]

;;;;;;;;;;;;;;;;;;;;;;;
;;; setup procedure ;;;
;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  set starting-seed new-seed
  random-seed new-seed
  create-turtles 300 [
    set-basics
  ]
  set-sex ;; set the sex of turtles
  set-willingness ;; set the likelihood of short-term mating
  set-standard ;; set the desirability standard for a short-term mate

  reset-ticks
end

to set-basics
    set shape "person"
    set size 1

    ;; set the desirability a random floating point from
    ;; a normal distribution with a mean of 5
    ;; and a standard deviation of 1.5
    set desirability random-normal 5 1.5

    set coupled? false ;; start without a partner
    set partner nobody
    set had-short-term-mate? false
    set short-term-mate? false
    set short-term-count 0
    set short-term-history [] ;; set an empty list to start with
    set number-of-short-partners 0 ;; set the number to 0 to start with
    set initiator? false ;; set non-initiator as the default option

    setxy random-xcor random-ycor
    ;; record the spawning point of a turtle
    set original-x xcor
    set original-y ycor
end

to set-sex
  ;; read the number of males from the slider bar
  ;; two colors indicate different sexes
  ;; turquoise turtles are males, orange ones are females
  ask turtles [ set color orange ]
  ask n-of number-of-males turtles [ set color turquoise ]
end

to set-willingness
  ;; read the likelihood setting from the slider bars
  ask turtles with [ color = turquoise ] [ set willingness male-willingness ]
  ask turtles with [ color = orange ] [ set willingness female-willingness ]
end

to set-standard
  ;; read the mating standard from the slider bars
  ask turtles with [ color = turquoise ] [ set desirability-standard male-desirability-standard ]
  ask turtles with [ color = orange ] [ set desirability-standard female-desirability-standard ]
end


;;;;;;;;;;;;;;;;;;;;
;;; go procedure ;;;
;;;;;;;;;;;;;;;;;;;;

to go
  ask turtles [
    ;; turtles randomly move around if not coupled
    if not coupled? [
      move
    ]
    ;; turtles make decisions about short-term mating preference
    decide-short-term
  ]

  ;; turtles make decisions on mating-behaviors
  ;; in the same-sex model, half of the population are initiators, who decide on mating
  ;; in the heterosexual-only model, males and females have an equal chance to decide on mating
  ifelse all-homosexual? [
    set-initiator
    ask turtles with [ initiator? ] [ mate ]
  ][
    ifelse random 100 < 50 [
      ask turtles with [ color = orange ] [ mate ]
    ][
      ask turtles with [ color = turquoise ] [ mate ]
    ]
    
  ]

  ask turtles [
    update-sexual-partner  ;; turtles update their number of short-term mating partners
    update-likelihood ;; turtles updating the likelihood for short-term mating
  ]
  tick
  update-my-plots ;; plotting
end

;;;;;;;;;;;;;;;;;;;;;;;;
;;; turtle behaviors ;;;
;;;;;;;;;;;;;;;;;;;;;;;;

;; turtle procedure: randomly move around the spawning point
to move 
  ;; check whether the turtle is away from the spawning point
  let out-range-x? (xcor > original-x + movement-range) or (xcor < original-x - movement-range)
  let out-range-y? (ycor > original-y + movement-range) or (ycor < original-y - movement-range)

  ;; if it is, facing the spawning point and move
  ;; if it's not, turn randomly and move
  ifelse out-range-x? or out-range-y? [
    facexy original-x original-y ][
    right random-float 180 ]
  forward random-float movement-range / 2
end

;; turtle procedure: to decide on short-term mating preference
to decide-short-term 
  ;; reset the decision on short-term mating
  set short-term-mate? false

  ;; the turtle decide to have short-term mating based on the parameter input
  if random-float 1 < willingness [ set short-term-mate? true ]
end

;; set initiators
to set-initiator 
  ;; reset initiator status
  ask turtles [ set initiator? false ]

  ;; in each tick, set half of turtles to be initiator
  let male-initiator (number-of-males / 2)
  let female-initiator (300 - number-of-males) / 2

  ask n-of male-initiator turtles with [ color = turquoise ] [ set initiator? true ]
  ask n-of female-initiator turtles with [ color = orange ] [ set initiator? true ]
end

;; turtle procedure: decide on mating behaviors
to mate 
  set had-short-term-mate? false  ;; reset the short-term mate flag
  short-term-mate  ;; decide whether to have short-term mating, regardless of being coupled or not

  ;; if a turtle is not coupled, and did not just have short-term mating, 
  ;; they decide whether to form long-term relationship
  if (not had-short-term-mate?) and (not coupled?) [
    long-term-mate
  ]
end

;; turtle procedure: have short-term mating
to short-term-mate 
  ;; check if there is someone else nearby who is not my partner
  ;; in the same-sex model, choose someone with the same sex
  ;; in the heterosexual-only model, choose someone of the opposite sex
  let target one-of other turtles-here with [ partner != myself and sex-match? ]

  if (target != nobody) [
    
    ;; if there is someone nearby, they meet my standards, and
    ;; both of us have a preference for short-term mating on this iteration,
    ;; we both increase the short-term mating experience by one, and 
    ;; add each other to the list of short-term sexual partners
    let meet-standard? [ desirability ] of target > desirability-standard and
                       [ desirability ] of self > [ desirability-standard ] of target

    if (short-term-mate?) and ([short-term-mate?] of target) and meet-standard? [
      set had-short-term-mate? true
      set short-term-count short-term-count + 1
      ask target [ 
        set had-short-term-mate? true
        set short-term-count short-term-count + 1 
      ]

      if not member? target short-term-history [
        set short-term-history fput target short-term-history
      ]
      if not member? self [short-term-history] of target [
        ask target [ set short-term-history fput myself short-term-history ]
      ]
    ]
  ]
end

;; turtle procedure: form long-term relationship
to long-term-mate 
  ;; check if there is an uncoupled individual nearby
  ;; in the same-sex model, choose someone with the same sex
  ;; in the heterosexual-only model, choose someone with opposite sex
  let potential-partner one-of other turtles-here
    with [ not coupled? and sex-match? ]

  ;; if there is someone nearby without a long-term partner, we form 
  ;; a long-term relationship by a chance specified by the parameter setting
  if (potential-partner != nobody) and (random-float 1 < long-term-likelihood) [
    
    ;; both of us record each other as the long-term partner, change the long-term
    ;; coupling status, and settle down on the patches we are currently on
    set partner potential-partner 
    set coupled? true 
    move-to patch-here ;; keep the couple in the center of the patch
    set pcolor grey - 3 ;; color the patch to visually show the relationship status

    ask partner [
      set partner myself
      set coupled? true
      move-to patch-here
      setxy xcor - 1 ycor
      set pcolor grey - 3
    ]
  ]
end

;; helper function: return a boolean variable indicating if the target turtle meets
;; the sex criterion based on the current model type (same-sex vs. heterosexual)
to-report sex-match? 
  ifelse all-homosexual? [
    report color = [ color ] of myself and not initiator?
  ][
    report color != [ color ] of myself
  ]
end

;; turtle procedure: count the number of short-term sexual partners
to update-sexual-partner 
  set number-of-short-partners length short-term-history
end

;; turtle procedure: update the likelihood of shorting-term mating
to update-likelihood 
  ;; decrease the short-terming likelihood to 1/3 if coupled
  ask turtles with [ color = turquoise and coupled?] [
    if willingness = male-willingness [
      set willingness (willingness / 3) ]
  ]
  ask turtles with [ color = orange and coupled?] [
    if willingness = female-willingness [
      set willingness (willingness / 3) ]
  ]
end

;;;;;;;;;;;;;;;;
;;; plotting ;;;
;;;;;;;;;;;;;;;;

to update-my-plots
  ;; plotting the relative frequency of coupled individuals
  set-current-plot "Coupled Agents (All)"
  set-current-plot-pen "Male"
  plotxy ticks count turtles with [color = turquoise and coupled?] / number-of-males * 100
  set-current-plot-pen "Female"
  plotxy ticks count turtles with [color = orange and coupled?] / (300 - number-of-males) * 100 

  ;; plotting the relative frequency of individuals who've had at least one short-term mate
  set-current-plot "In-Pool Agents" 
  set-current-plot-pen "Male"
  plotxy ticks count turtles with [ color = turquoise and short-term-count > 0 ] / number-of-males * 100 
  set-current-plot-pen "Female"
  plotxy ticks count turtles with [ color = orange and short-term-count > 0 ] / (300 - number-of-males) * 100 

  ;; plotting the mean number of unique short-term sexual partners among all males and females
  set-current-plot "Unique Partners (All)" 
  set-current-plot-pen "Male"
  plotxy ticks mean [number-of-short-partners] of turtles with [ color = turquoise ] 
  set-current-plot-pen "Female"
  plotxy ticks mean [number-of-short-partners] of turtles with [ color = orange ] 
  
  ;; plotting the mean number of unique short-term sexual partners among males and females who've had at least 1 short-term mate
  set-current-plot "Unique Partners (In-Pool)" 
  ifelse (count turtles with [ color = turquoise and short-term-count > 0 ] != 0) [
    set avg-unique-partners-of-in-pool-males (sum [number-of-short-partners] of turtles with [ color = turquoise ]) 
      / (count turtles with [ color = turquoise and short-term-count > 0 ])
  ] [
    set avg-unique-partners-of-in-pool-males 0
  ]
  set-current-plot-pen "Male"
  plotxy ticks avg-unique-partners-of-in-pool-males
  
  ifelse (count turtles with [ color = orange and short-term-count > 0 ] != 0) [
    set avg-unique-partners-of-in-pool-females (sum [number-of-short-partners] of turtles with [ color = orange ]) 
      / (count turtles with [ color = orange and short-term-count > 0 ])
  ] [
    set avg-unique-partners-of-in-pool-females 0
  ]
  set-current-plot-pen "Female"
  plotxy ticks avg-unique-partners-of-in-pool-females

  set-current-plot "Encounters (All)"
  set-current-plot-pen "Male"
  plotxy ticks mean [short-term-count] of turtles with [ color = turquoise ]
  set-current-plot-pen "Female"
  plotxy ticks mean [short-term-count] of turtles with [ color = orange ]

  set-current-plot "Encounters (In-Pool)"
  ifelse (count turtles with [ color = turquoise and short-term-count > 0 ] != 0) [
    set avg-encounters-of-in-pool-males (sum [short-term-count] of turtles with [ color = turquoise ])
      / (count turtles with [ color = turquoise and short-term-count > 0 ])
    
  ] [
    set avg-encounters-of-in-pool-males 0
  ]
  set-current-plot-pen "Male"
  plotxy ticks avg-encounters-of-in-pool-males
  
  ifelse (count turtles with [ color = orange and short-term-count > 0 ] != 0) [
    set avg-encounters-of-in-pool-females (sum [short-term-count] of turtles with [ color = orange ])
      / (count turtles with [ color = orange and short-term-count > 0 ])
  ] [
    set avg-encounters-of-in-pool-females 0
  ]
  set-current-plot-pen "Female"
  plotxy ticks avg-encounters-of-in-pool-females

end]]></code>
